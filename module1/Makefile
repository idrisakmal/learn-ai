# Config Service — common development tasks.
#
# Run `make` or `make help` for the list. Every target is safe to run twice.
# Bun is the package manager only; the application runs on Node.

SVC          := config-service
UI           := ui

PG_CONTAINER := config-service-pg
PG_IMAGE     := postgres:16
PG_PORT      := 5435
PG_USER      := config
PG_PASSWORD  := config
PG_DB        := config_service
PG_TEST_DB   := config_service_test
PG_VOLUME    := config-service-pgdata
# Give up waiting for the database rather than hanging forever if it fails to start.
PG_WAIT_SECONDS := 60

TEST_DATABASE_URL := postgresql://$(PG_USER):$(PG_PASSWORD)@localhost:$(PG_PORT)/$(PG_TEST_DB)?schema=public

.DEFAULT_GOAL := help
.PHONY: help setup env install dev build start test test-watch lint format format-check \
        check migrate migrate-test seed db-up db-down db-shell db-reset clean \
        ui-install ui-dev ui-build ui-test ui-test-watch ui-lint ui-check

help: ## Show this help
	@echo "Config Service — make targets:"
	@awk 'BEGIN {FS = ":.*?## "} /^[a-zA-Z_-]+:.*?## / {printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

## --- Setup ---------------------------------------------------------------
##
## Prerequisites: Node.js 22+, Bun, Docker. Everything else `make setup` handles.

setup: install ui-install db-up migrate migrate-test ## Prepare a fresh machine end to end
	@echo ""
	@echo "Ready. Try: make test"
	@echo "For the admin UI: 'make seed', then 'make dev' and 'make ui-dev' in two terminals."

# .env is git-ignored, so a fresh clone has none and every Prisma and dev
# command would fail without this.
$(SVC)/.env: $(SVC)/.env.example
	@cp $(SVC)/.env.example $@
	@echo "Created $@ from .env.example — review it before running for real."

env: $(SVC)/.env ## Create .env from .env.example if it is missing

install: env ## Install dependencies and generate the Prisma client
	cd $(SVC) && bun install
	@# Bun does not run untrusted postinstall scripts, so the Prisma client
	@# is not generated by `bun install` alone. Generating it is idempotent.
	cd $(SVC) && bunx prisma generate

## --- Development ---------------------------------------------------------

dev: db-up ## Run the service with reload (port 3999)
	cd $(SVC) && bun run dev

build: ## Compile TypeScript to dist/
	cd $(SVC) && bun run build

start: ## Run the compiled service on Node
	cd $(SVC) && bun run start

## --- Quality -------------------------------------------------------------

# TEST_DATABASE_URL is passed explicitly so the tests and `migrate-test` always
# agree; vitest.config.ts falls back to its own default only when it is unset.
test: db-up ## Run the test suite against the test database
	cd $(SVC) && TEST_DATABASE_URL="$(TEST_DATABASE_URL)" bun run test

test-watch: db-up ## Run tests in watch mode
	cd $(SVC) && TEST_DATABASE_URL="$(TEST_DATABASE_URL)" bunx vitest watch

lint: ## Lint with ESLint
	cd $(SVC) && bun run lint

# Formatting covers both packages in one target: the style is repo-wide
# (.prettierrc.json sits above both), so splitting it per package would invite
# them to drift apart.
format: ## Format the service and the UI with Prettier
	cd $(SVC) && bun run format
	cd $(UI) && bun run format

format-check: ## Fail if anything is unformatted (what `check` runs)
	cd $(SVC) && bun run format:check
	cd $(UI) && bun run format:check

check: lint format-check build test ui-check ## Everything CI would run, service and UI
	@echo "All checks passed."

## --- Admin UI ------------------------------------------------------------
##
## The UI proxies /api to the service on 3999, so `make dev` must be running
## in another terminal for `make ui-dev` to load any data.

ui-install: ## Install UI dependencies
	cd $(UI) && bun install

ui-dev: ## Run the admin UI with reload (port 5173)
	cd $(UI) && bun run dev

ui-build: ## Type-check and bundle the UI to ui/dist
	cd $(UI) && bun run build

ui-test: ## Run the UI test suite (no database needed)
	cd $(UI) && bun run test

ui-test-watch: ## Run the UI tests in watch mode
	cd $(UI) && bunx vitest watch

ui-lint: ## Lint the UI with ESLint
	cd $(UI) && bun run lint

ui-check: ui-lint ui-build ui-test ## Lint, build, and test the UI

## --- Database ------------------------------------------------------------

db-up: ## Start PostgreSQL and ensure both databases exist
	@command -v docker >/dev/null || { echo "Docker is required but not installed."; exit 1; }
	@if [ -z "$$(docker ps -q -f name=^$(PG_CONTAINER)$$)" ]; then \
	  if [ -n "$$(docker ps -aq -f name=^$(PG_CONTAINER)$$)" ]; then \
	    echo "Starting existing $(PG_CONTAINER)..."; \
	    docker start $(PG_CONTAINER) >/dev/null; \
	  else \
	    echo "Creating $(PG_CONTAINER) on port $(PG_PORT)..."; \
	    docker run -d --name $(PG_CONTAINER) \
	      -e POSTGRES_USER=$(PG_USER) \
	      -e POSTGRES_PASSWORD=$(PG_PASSWORD) \
	      -e POSTGRES_DB=$(PG_DB) \
	      -p $(PG_PORT):5432 \
	      -v $(PG_VOLUME):/var/lib/postgresql/data \
	      $(PG_IMAGE) >/dev/null; \
	  fi; \
	  printf "Waiting for PostgreSQL"; \
	  for i in $$(seq 1 $(PG_WAIT_SECONDS)); do \
	    if docker exec $(PG_CONTAINER) pg_isready -U $(PG_USER) -q 2>/dev/null; then break; fi; \
	    if [ $$i -eq $(PG_WAIT_SECONDS) ]; then \
	      echo ""; \
	      echo "PostgreSQL did not become ready in $(PG_WAIT_SECONDS)s. Container logs:"; \
	      docker logs --tail 20 $(PG_CONTAINER) 2>&1 || true; \
	      exit 1; \
	    fi; \
	    printf "."; sleep 1; \
	  done; \
	  echo " ready."; \
	fi
	@# CREATE DATABASE has no IF NOT EXISTS, so check first.
	@docker exec $(PG_CONTAINER) psql -U $(PG_USER) -d postgres -tAc \
	  "SELECT 1 FROM pg_database WHERE datname='$(PG_TEST_DB)'" | grep -q 1 || \
	  docker exec $(PG_CONTAINER) psql -U $(PG_USER) -d postgres -c "CREATE DATABASE $(PG_TEST_DB)" >/dev/null

db-down: ## Stop PostgreSQL (data is kept)
	docker stop $(PG_CONTAINER)

db-shell: db-up ## Open psql against the development database
	docker exec -it $(PG_CONTAINER) psql -U $(PG_USER) -d $(PG_DB)

migrate: db-up ## Create and apply a migration (development database)
	cd $(SVC) && bun run migrate

# Development data only. The test suite builds its own fixtures and truncates
# between cases, so it never sees any of this.
seed: db-up ## Load demo applications and configurations (development database)
	cd $(SVC) && bun run seed

migrate-test: db-up ## Apply existing migrations to the test database
	cd $(SVC) && DATABASE_URL="$(TEST_DATABASE_URL)" bunx prisma migrate deploy

db-reset: db-up ## Drop and recreate both databases, then re-apply migrations
	@echo "Dropping and recreating $(PG_DB) and $(PG_TEST_DB)..."
	@docker exec $(PG_CONTAINER) psql -U $(PG_USER) -d postgres -c "DROP DATABASE IF EXISTS $(PG_DB)" >/dev/null
	@docker exec $(PG_CONTAINER) psql -U $(PG_USER) -d postgres -c "DROP DATABASE IF EXISTS $(PG_TEST_DB)" >/dev/null
	@docker exec $(PG_CONTAINER) psql -U $(PG_USER) -d postgres -c "CREATE DATABASE $(PG_DB)" >/dev/null
	@docker exec $(PG_CONTAINER) psql -U $(PG_USER) -d postgres -c "CREATE DATABASE $(PG_TEST_DB)" >/dev/null
	cd $(SVC) && bunx prisma migrate deploy
	cd $(SVC) && DATABASE_URL="$(TEST_DATABASE_URL)" bunx prisma migrate deploy

## --- Housekeeping --------------------------------------------------------

clean: ## Remove build output (leaves node_modules and the database alone)
	rm -rf $(SVC)/dist $(UI)/dist
