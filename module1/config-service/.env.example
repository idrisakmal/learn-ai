# Copy to .env and adjust for your environment.
# The application runs on Node.js; Bun is only the package manager.

# PostgreSQL connection string (PostgreSQL 16).
DATABASE_URL="postgresql://config:config@localhost:5435/config_service?schema=public"

# HTTP port the service listens on.
PORT=3000

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Node environment: development | test | production
NODE_ENV=development
